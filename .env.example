# 本文件只说明可用的进程环境变量，不会被程序或 scripts/start.ps1 自动读取。
# 推荐直接使用桌面“模型服务”：保存后对下一次请求生效，当前 Windows 账户加密保存。
# 这些变量仅是内置平台在尚未保存本机配置时的后备来源，不会覆盖单独添加的平台。
# 内置平台清除密钥并停用后会持久化 none，不会退回使用环境中的旧密钥。
# 如需使用环境变量，请通过启动助手的 PowerShell、MCP 客户端环境或凭据管理工具提供。
# 不要把真实 API key 写入仓库、提示词、截图或提交记录。

# 内置平台的模型调用默认关闭。可选值：none、openai、gemini、qwen。
# SYNTHV_AUDIO_* 是保留的兼容变量名；0.4 起音频入口退役，不会因配置这些变量重新启用。
# 配置或持有密钥本身不会发起模型请求；发送会话、刷新目录和连接测试由用户主动触发。
SYNTHV_AUDIO_PROVIDER=none

# 内置平台的模型 ID；建议明确填写该账户可用、能生成结构化文字回复的型号。
# 留空仍使用 settings.py 中保留的供应商兼容默认值，不表示该型号适合当前参数规划。
# 会话可以另选模型；实际可用性、推理档位和额度取决于所用服务，无需模型具备音频能力。
SYNTHV_AUDIO_MODEL=

# 对应供应商的密钥，由进程环境提供。此处有意保留空值。
OPENAI_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# 可选 HTTPS API 根路径。留空使用官方端点；不要填写完整方法 URL。
# 自定义服务会收到对应凭据、本次文字与受限历史，以及用户明确附带的选区摘要。
# 只使用可信服务；历史音频不会随当前会话上传。
# Qwen 默认 https://dashscope.aliyuncs.com/compatible-mode/v1（北京）；其他地域/业务空间
# 应复制百炼控制台的对应 Base URL，并使用同地域、同空间的 API key。
SYNTHV_AUDIO_BASE_URL=

# 等待超时秒数，允许 5～180；不会自动重试计费请求。
# 流式会话按首次正文/思考摘要及后续无新输出的间隔计时，有效输出自动续期。
# 会话另有 30 分钟总上限；变量沿用历史名称，不表示仍开放非流式 A/B 听评。
SYNTHV_AUDIO_TIMEOUT_SECONDS=60

# 以下变量通常无需配置；源码启动默认使用项目 data，完整发行包使用本机应用资料目录。
# 工作台会自动查找唯一 SynthV 实例，具体资料路径见 docs/desktop-workbench.md。
# 若更改数据目录，Python 服务和 MCP 必须保持一致，并重新打包安装 Lua 桥接。
# SYNTHV_ASSISTANT_DATA=C:\path\to\synthv-assistant\data

# 多个 SynthV 实例同时打开时指定真实目标 PID；示例值不能直接照抄。
# SYNTHV_ASSISTANT_PID=12345
